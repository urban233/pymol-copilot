# The committed record of the frozen split: its manifest and datasheet,
# and after the label audit the filled sheet and its result. The split
# itself lives under data/splits/, which is not tracked.
filegroup(
    name = "dataset_docs",
    srcs = ["DATASHEET.md", "manifest.json"] + glob(
        ["audit/*"],
        # Empty until the label audit is scored.
        allow_empty = True,
    ),
    visibility = ["//tests/data:__pkg__"],
)
