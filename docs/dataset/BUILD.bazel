# The committed record of the frozen split: its manifest and datasheet,
# and after the label audit the filled sheet and its result; history/
# keeps the same record for every superseded split version. The split
# itself lives under data/splits/, which is not tracked.
filegroup(
    name = "dataset_docs",
    srcs = glob(
        ["**/*.json", "**/*.jsonl", "**/*.md"],
        # Empty only between moving a superseded split into history/ and
        # freezing its replacement; test_manifest.py fails meanwhile.
        allow_empty = True,
    ),
    # tests/eval checks that the committed baseline was measured on this
    # exact split (docs/master_plan.md item 16).
    visibility = [
        "//tests/data:__pkg__",
        "//tests/eval:__pkg__",
        "//tests/notebook:__pkg__",
        "//tests/integrated:__pkg__",
    ],
)
