/* Light theme for the cBioMOL AI assistant task workflow UI. */

QMainWindow {
  background-color: #F5F6FA;
}

QWidget#contentColumn {
  background-color: #F5F6FA;
}

QFrame#promptCard {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 12px;
}

QFrame#promptCard:focus-within {
  border: 2px solid #DBEAFE;
}

QTextEdit#promptInput,
QTextEdit#followUpInput {
  background-color: transparent;
  border: none;
  color: #1A1D26;
  font-size: 14px;
  padding: 8px;
}

QTextEdit#promptInput {
  min-height: 80px;
}

QTextEdit#followUpInput {
  min-height: 36px;
  max-height: 72px;
}

QPushButton#submitButton {
  background-color: #2563EB;
  color: #FFFFFF;
  border: none;
  border-radius: 16px;
  min-width: 32px;
  min-height: 32px;
  font-weight: bold;
}

QPushButton#submitButton:disabled {
  background-color: #CBD5E1;
}

QPushButton#stopButton {
  background-color: #FFFFFF;
  color: #1A1D26;
  border: 1px solid #E2E8F0;
  border-radius: 16px;
  padding: 6px 14px;
}

QPushButton#modeButton {
  background-color: transparent;
  color: #6B7280;
  border: none;
  padding: 4px 10px;
}

QPushButton#modeButton:checked {
  color: #2563EB;
  font-weight: bold;
}

QFrame#recapCard,
QFrame#summaryCard {
  background-color: #EEF0F5;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 12px;
}

QLabel#sectionTitle {
  color: #1A1D26;
  font-size: 16px;
  font-weight: bold;
}

QLabel#taskTitle {
  color: #1A1D26;
  font-size: 18px;
  font-weight: bold;
}

QLabel#secondaryLabel {
  color: #6B7280;
  font-size: 12px;
}

QLabel#recapText,
QLabel#summaryText {
  color: #1A1D26;
  font-size: 14px;
}

QFrame#planStepRow {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 8px 12px;
}

QLabel#stepPending {
  color: #6B7280;
}

QLabel#stepActive {
  color: #16A34A;
  font-weight: bold;
}

QLabel#stepDone {
  color: #1A1D26;
}

QListWidget#sessionList {
  background-color: #EEF0F5;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
}

QListWidget#sessionList::item {
  padding: 8px;
  color: #1A1D26;
}

QListWidget#sessionList::item:selected {
  background-color: #DBEAFE;
}

QPushButton#footerButton {
  background-color: transparent;
  border: none;
  color: #6B7280;
  padding: 6px;
}

QPushButton#runActionsStub {
  background-color: #EEF0F5;
  color: #6B7280;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 8px 16px;
}

QFrame#verificationBar {
  background-color: #FFFFFF;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 8px 12px;
}

QPushButton#cancelButton {
  background-color: #FFFFFF;
  color: #1A1D26;
  border: 1px solid #E2E8F0;
  border-radius: 8px;
  padding: 8px 16px;
}

QPushButton#runActionsButton {
  background-color: #2563EB;
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  padding: 8px 16px;
  font-weight: bold;
}

QPushButton#runActionsButton:disabled {
  background-color: #CBD5E1;
  color: #6B7280;
}

QPushButton#saveSessionButton {
  background-color: #2563EB;
  color: #FFFFFF;
  border: none;
  border-radius: 8px;
  padding: 8px 16px;
  font-weight: bold;
}

QPushButton#saveSessionButton:disabled {
  background-color: #CBD5E1;
  color: #6B7280;
}

QLabel#stepError {
  color: #DC2626;
  font-size: 12px;
}

QLabel#statusFailed {
  color: #DC2626;
  font-size: 20px;
  font-weight: bold;
}

QLabel#statusDone {
  color: #16A34A;
  font-size: 20px;
  font-weight: bold;
}

QLabel#cancelBanner {
  color: #B45309;
  background-color: #FEF3C7;
  border-radius: 8px;
  padding: 8px;
}
