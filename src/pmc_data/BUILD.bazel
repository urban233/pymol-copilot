load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

py_library(
    name = "pmc_data",
    srcs = [
        "__init__.py",
        "colors.py",
        "generate.py",
        "gold_case.py",
        "gold_set.py",
        "oracle.py",
        "pdb.py",
        "report.py",
        "sample.py",
        "split.py",
        "structures.py",
        "taxonomy.py",
        "verifier.py",
    ],
    data = [
        "conformance/rejections.jsonl",
        "conformance/samples.jsonl",
        "gold/gold_items.jsonl",
        "gold_cases/chain_a_red.json",
        "gold_cases/chain_a_red_second_fixture_gold_case.json",
    ],
    imports = [".."],
    deps = ["//src/pmc_core:pmc_core"],
    visibility = ["//src/pmc_data:__pkg__", "//src:tests"],
)

py_binary(
    name = "generate_cli",
    srcs = ["generate_cli.py"],
    main = "generate_cli.py",
    data = ["//configs/generation:chain_a_red_structures.json"],
    # Launches real Open-Source PyMOL to (re)generate the checked-in
    # gold_cases/*.json records, so it hit the same MAX_PATH failure as
    # every other real-PyMOL target here (issue #12). It runs on Windows
    # now: //tools/winstage stages the wheel to a short path before the
    # import below. The shim lives under tools/ rather than tests/ exactly
    # so this target can use it -- src may not depend on tests, per
    # src/BUILD.bazel's own package groups -- and nothing ships from
    # tools/. This is a developer data-generation binary, not runtime:
    # tools/bazel/check_dependency_boundaries.py forbids pmc_data from
    # every runtime closure it enforces, so the shim cannot reach one
    # through here.
    deps = [
        "@pypi//pymol_open_source_whl",
        "//src/pmc_data:pmc_data",
        "//tools/winstage:winstage",
    ],
)

# The corpus generator. Not a test: a few thousand samples means a few
# thousand spawned PyMOL children, so it runs by hand via bazel run and
# writes into the source tree through BUILD_WORKSPACE_DIRECTORY. It
# never imports PyMOL itself -- pmc_core.executor spawns
# pmc_sidecar.child, which is the only thing that does, and which this
# target depends on so the child module is on the spawned
# interpreter's path.
py_binary(
    name = "corpus_cli",
    srcs = ["corpus_cli.py"],
    main = "corpus_cli.py",
    data = ["//configs/generation:corpus.json"],
    deps = [
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_sidecar:pmc_sidecar",
    ],
    # Visible to tests so //tests/data:corpus_cli can import the module
    # and settle how a run names and promotes its directory, which is
    # the part of this binary that can destroy a corpus and the part
    # that needs no PyMOL to exercise. Runtime closures are unaffected:
    # nothing ships from here, and this target already depends on
    # pmc_data, which tools/bazel/check_dependency_boundaries.py
    # forbids every runtime root anyway.
    visibility = ["//src:tests"],
)

# The committed conformance slice, exported so tests/data can replay it
# without depending on the whole library's data.
filegroup(
    name = "conformance_slice",
    srcs = [
        "conformance/rejections.jsonl",
        "conformance/samples.jsonl",
    ],
    visibility = ["//src:tests"],
)
