load("@rules_python//python:py_library.bzl", "py_library")

# The one package permitted to import both real PyMOL and //tools/winstage:
# the fresh-process child pmc_core.executor spawns by module name
# ("python -m pmc_sidecar.child"), never by import, so pmc_core itself never
# acquires either dependency. tools/bazel/check_dependency_boundaries.py's
# FORBIDDEN set names this package as defence in depth behind that: the
# spawn-by-module-name discipline is a convention pmc_core.executor follows,
# not something Bazel's dependency graph enforces on its own, since a
# subprocess launched by module string has no Bazel edge to the module it
# runs. See docs/master_plan.md item 4 (the sidecar executor) and
# tools/winstage/BUILD.bazel's own docstring for the Windows staging shim
# every real-PyMOL import here must call first.
py_library(
    name = "pmc_sidecar",
    srcs = ["__init__.py"],
    imports = [".."],
    visibility = ["//src:subsystems", "//src:tests"],
    deps = [
        "//src/pmc_core:pmc_core",
        "//tools/winstage:winstage",
        "@pypi//pymol_open_source_whl",
    ],
)
