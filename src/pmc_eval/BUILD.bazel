load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

# The offline evaluation harness (docs/master_plan.md item 16). It drives
# pmc_agent's request graph and grades against pmc_data's stored samples,
# so it sits above both and nothing in src may depend on it: visibility
# is its own package plus tests. It deliberately does not depend on
# //src/pmc_sidecar -- only the eval_cli binary and the real-PyMOL test
# do, as with pmc_data's corpus_cli, so the hermetic eval tests never
# pull the PyMOL wheel in.
py_library(
    name = "pmc_eval",
    srcs = [
        "__init__.py",
        "compare.py",
        "config.py",
        "grade.py",
        "metrics.py",
        "prompt.py",
        "record.py",
        "runner.py",
        "screen_reasons.py",
    ],
    imports = [".."],
    deps = [
        "//src/pmc_agent:pmc_agent",
        "//src/pmc_agent/inference:inference",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "@pypi//langgraph",
        "@pypi//langgraph_checkpoint",
    ],
    visibility = ["//src/pmc_eval:__pkg__", "//src:tests"],
)

# Runs the offline evaluation and publishes the baseline. Not a test:
# a run is hours of local-model inference and a fresh PyMOL child per
# attempt, so it runs by hand via bazel run and writes into the source
# tree through BUILD_WORKSPACE_DIRECTORY. It never imports PyMOL
# itself -- pmc_core.executor spawns pmc_sidecar.child, which this
# target depends on so the child module is on the spawned
# interpreter's path. Visible to tests so //tests/eval:eval_cli can
# drive it against a fake model and sidecar.
py_binary(
    name = "eval_cli",
    srcs = ["eval_cli.py"],
    main = "eval_cli.py",
    data = ["//configs/evaluation:baseline.json"],
    deps = [
        "@pypi//httpx",
        "//src/pmc_agent/inference:inference",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_eval:pmc_eval",
        "//src/pmc_sidecar:pmc_sidecar",
    ],
    visibility = ["//src:tests"],
)
