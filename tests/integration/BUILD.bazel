load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# Shared real-PyMOL test support for pmc_core.snapshot's round-trip
# evidence: the real_pymol/loaded_fixture fixtures, the fixture PDB, and
# the nested-subprocess-via-environment-variable technique
# (run_nested_snapshot_process). Ported from
# tests/discovery/h02/harness.py once that module's production content
# moved to src/pmc_core/snapshot.py. Visibility also reaches
# tests/discovery/h02, whose surviving execution-boundary probes request
# the same real_pymol fixture (re-exported by that package's own
# conftest.py) to compute an independent expected value.
py_library(
    name = "snapshot_support",
    srcs = ["snapshot_support.py"],
    data = [
        "conftest.py",
        "testdata/h02_full_v1_fixture.pdb",
    ],
    imports = ["."],
    visibility = [
        "//tests/discovery/h02:__pkg__",
    ],
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//tools/winstage:winstage",
    ],
)

py_test(
    name = "command",
    size = "small",
    srcs = ["test_command.py"],
    main = "test_command.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_client:pmc_client",
        "//src/pmc_core:pmc_core",
    ],
)

py_test(
    name = "subsystem_imports",
    srcs = ["test_subsystem_imports.py"],
    main = "test_subsystem_imports.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_agent:pmc_agent",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
    ],
)

py_test(
    name = "loopback_transport",
    size = "small",
    srcs = ["test_loopback_transport.py"],
    main = "test_loopback_transport.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_client:pmc_client",
        "//src/pmc_core:pmc_core",
        "//src/pmc_server:pmc_server",
    ],
)

py_test(
    name = "client_server_command",
    size = "medium",
    timeout = "short",
    srcs = ["test_client_server_command.py"],
    main = "test_client_server_command.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_client:pmc_client",
        "//src/pmc_core:pmc_core",
        "//src/pmc_server:pmc_server",
    ],
)

py_test(
    name = "real_pymol_command",
    size = "large",
    timeout = "moderate",
    srcs = ["test_real_pymol_command.py"],
    main = "test_real_pymol_command.py",
    data = ["testdata/two_chain_fixture.pdb"],
    tags = ["exclusive"],
    # No longer excluded on Windows: pymol-open-source-whl's Windows wheel
    # bundles delvewheel-repaired DLLs with long hash-suffixed names, and
    # combined with Bazel's generated repository name for this dependency,
    # the resulting path used to exceed Windows' MAX_PATH (260 chars) when
    # the compiled _cmd extension loaded its bundled dependencies.
    # //tools/winstage:winstage now stages a short-path copy before this
    # module's own real-PyMOL import (a no-op on every other platform). See
    # issue #12.
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_client:pmc_client",
        "//src/pmc_core:pmc_core",
        "//src/pmc_server:pmc_server",
        "//tools/winstage:winstage",
    ],
)

py_test(
    name = "real_pymol_allowlist",
    size = "large",
    timeout = "moderate",
    srcs = ["test_real_pymol_allowlist.py"],
    main = "test_real_pymol_allowlist.py",
    # Launches real headless PyMOL, which supports one finish_launching per
    # interpreter; excluded from concurrent scheduling for the same reason
    # as :real_pymol_command. //tools/winstage stages a short-path copy
    # before this module's own import pymol (issue #12).
    tags = ["exclusive"],
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//tools/winstage:winstage",
    ],
)

py_test(
    name = "snapshot_round_trip",
    size = "large",
    timeout = "moderate",
    srcs = ["test_snapshot_round_trip.py"],
    main = "test_snapshot_round_trip.py",
    data = [
        "conftest.py",
        "testdata/h02_full_v1_fixture.pdb",
    ],
    # Spawns a subprocess that launches its own real PyMOL process;
    # excluded from concurrent scheduling for the same reason as
    # tests/data:oracle_sabotage and tests/contract:policy_sabotage, so it
    # never races another subprocess-spawning test under Windows's
    # unsandboxed local execution strategy (observed CI flake).
    tags = ["exclusive"],
    deps = [
        ":snapshot_support",
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
    ],
)

py_test(
    name = "card_real_pymol",
    size = "large",
    timeout = "moderate",
    srcs = ["test_card_real_pymol.py"],
    main = "test_card_real_pymol.py",
    data = [
        "conftest.py",
        "testdata/h02_full_v1_fixture.pdb",
    ],
    # Launches real headless PyMOL, which supports one finish_launching
    # per interpreter; excluded from concurrent scheduling for the same
    # reason as :real_pymol_command.
    tags = ["exclusive"],
    deps = [
        ":snapshot_support",
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
    ],
)

py_test(
    name = "snapshot_nested_process",
    size = "large",
    timeout = "moderate",
    srcs = ["test_snapshot_nested_process.py"],
    main = "test_snapshot_nested_process.py",
    data = ["conftest.py"],
    # Spawns a nested pytest subprocess that launches its own real PyMOL
    # process and lets it reach shutdown before failing -- the masking
    # condition run_nested_snapshot_process works around only manifests
    # once real PyMOL is actually involved, so this target cannot be a
    # PyMOL-free "small" target. Excluded from concurrent scheduling for
    # the same reason as tests/data:oracle_sabotage and
    # tests/contract:policy_sabotage.
    tags = ["exclusive"],
    deps = [
        ":snapshot_support",
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
    ],
)
