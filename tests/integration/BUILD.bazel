# A test-owned fidelity child pmc_core.executor.probe_fidelity() can spawn
# in place of the production src/pmc_sidecar/fidelity.py: unlike
# :sabotage_child below, it genuinely reconstructs and re-extracts in real
# PyMOL first, then perturbs one field of its own honest re-extraction
# before reporting it -- see its own module docstring for why that
# distinction matters to what it proves.
py_library(
    name = "fidelity_sabotage_child",
    srcs = ["fidelity_sabotage_child.py"],
    imports = ["."],
    visibility = ["//tests/integration:__pkg__"],
    deps = [
        "@pypi//pymol_open_source_whl",
        "//src/pmc_core:pmc_core",
        "//tools/winstage:winstage",
    ],
)

