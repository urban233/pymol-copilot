load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "parser_rejections",
    srcs = ["test_parser_rejections.py"],
    main = "test_parser_rejections.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
    ],
)

# The denied-form corpus, extracted so test_hostile_screen.py can assert
# src/pmc_core/screen.py against exactly the literals test_denied_forms.py
# already proves the parser and policy deny, rather than a second,
# hand-copied list that could drift from this one.
py_library(
    name = "denied_forms_corpus",
    srcs = ["denied_forms.py"],
    imports = ["."],
    visibility = ["//tests/adversarial:__pkg__"],
)

py_test(
    name = "denied_forms",
    size = "small",
    srcs = ["test_denied_forms.py"],
    main = "test_denied_forms.py",
    deps = [
        ":denied_forms_corpus",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
    ],
)

py_test(
    name = "parser_totality",
    size = "small",
    srcs = ["test_parser_totality.py"],
    main = "test_parser_totality.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
    ],
)

py_test(
    name = "hostile_screen",
    size = "small",
    srcs = ["test_hostile_screen.py"],
    main = "test_hostile_screen.py",
    deps = [
        ":denied_forms_corpus",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
    ],
)

test_suite(
    name = "all",
    tests = [
        ":denied_forms",
        ":hostile_screen",
        ":parser_rejections",
        ":parser_totality",
    ],
)
