# Tests for the offline evaluation harness (docs/master_plan.md item 16).
# See README.md for what each module settles.
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

py_test(
    name = "prompt",
    size = "small",
    srcs = ["test_prompt.py"],
    main = "test_prompt.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_agent:pmc_agent",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_eval:pmc_eval",
    ],
)

py_test(
    name = "screen_reasons",
    size = "small",
    srcs = ["test_screen_reasons.py"],
    main = "test_screen_reasons.py",
    deps = [
        "//tests/adversarial:denied_forms_corpus",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//src/pmc_eval:pmc_eval",
    ],
)

py_test(
    name = "grade",
    size = "small",
    srcs = ["test_grade.py"],
    main = "test_grade.py",
    deps = [
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_eval:pmc_eval",
    ],
)

# The scripted executors and completions every hermetic harness suite
# shares, imported as a bare sibling module.
py_library(
    name = "fakes",
    srcs = ["fakes.py"],
    imports = ["."],
    deps = [
        "//src/pmc_agent/inference:inference",
        "//src/pmc_core:pmc_core",
    ],
)

py_test(
    name = "runner",
    size = "small",
    srcs = ["test_runner.py"],
    main = "test_runner.py",
    deps = [
        ":fakes",
        "@pypi//pytest",
        "//src/pmc_agent:pmc_agent",
        "//src/pmc_agent/inference:inference",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_eval:pmc_eval",
    ],
)
