py_test(
    name = "generate_real_pymol",
    size = "large",
    timeout = "moderate",
    srcs = ["test_generate_real_pymol.py"],
    main = "test_generate_real_pymol.py",
    tags = ["exclusive"],
    data = [
        "testdata/no_chain_a_fixture.pdb",
        "testdata/second_gold_fixture.pdb",
        "//configs/generation:chain_a_red_structures.json",
    ],
    # No longer excluded on Windows: see gold_case_verifier's identical
    # comment below. //tools/winstage:winstage now stages a short-path
    # copy before this module's own real-PyMOL import (a no-op on every
    # other platform). See issue #12.
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//tools/winstage:winstage",
    ],
)

py_test(
    name = "gold_case_verifier",
    size = "large",
    timeout = "moderate",
    srcs = ["test_gold_case_verifier.py"],
    main = "test_gold_case_verifier.py",
    tags = ["exclusive"],
    data = [
        "testdata/chain_a_gold_fixture.pdb",
        "testdata/renumbered_serials_fixture.pdb",
    ],
    # No longer excluded on Windows: tests/integration/BUILD.bazel's
    # real_pymol_command target hit the same MAX_PATH failure (issue
    # #12: pymol-open-source-whl's Windows wheel bundles delvewheel-
    # repaired DLLs whose long hash-suffixed names, combined with
    # Bazel's generated repository name, exceed Windows' MAX_PATH) and
    # fixed it in-repository with //tools/winstage:winstage, a
    # short-path staging shim this target now calls too, below, before
    # its own real-PyMOL import.
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//tools/winstage:winstage",
    ],
)

