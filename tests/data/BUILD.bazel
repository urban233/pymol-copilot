# The admission gate for the controlled structure matrix. Spawns a real
# pmc_sidecar.fidelity child per structure through
# pmc_core.executor.probe_fidelity(), so it is excluded from concurrent
# scheduling for the same reason as every other real-PyMOL target here.
py_test(
    name = "structures_real_pymol",
    size = "large",
    timeout = "long",
    srcs = ["test_structures_real_pymol.py"],
    main = "test_structures_real_pymol.py",
    tags = ["exclusive"],
    deps = [
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_sidecar:pmc_sidecar",
    ],
)

# The differential that settles whether the oracle reads Open-Source
# PyMOL's own selection semantics correctly: it reconstructs a
# controlled structure in real headless PyMOL and compares cmd.iterate
# against the oracle's prediction for the same expression. Excluded from
# concurrent scheduling like every other in-process real-PyMOL target.
py_test(
    name = "oracle_real_pymol",
    size = "large",
    timeout = "moderate",
    srcs = ["test_oracle_real_pymol.py"],
    main = "test_oracle_real_pymol.py",
    tags = ["exclusive"],
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
        "//src/pmc_core:pmc_core",
        "//src/pmc_data:pmc_data",
        "//src/pmc_sidecar:pmc_sidecar",
        "//tools/winstage:winstage",
    ],
)

