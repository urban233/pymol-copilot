load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# Slice 3's fresh-process hermetic execution boundary prototype: the
# request/report shapes and the `execute()` process primitive itself. Its
# own module code never imports pymol directly (only the child runner
# script it spawns does), but it does import pmc_core.snapshot for the
# shared ObjectSnapshot/from_json/to_json/extract it reuses.
py_library(
    name = "execution_boundary",
    srcs = ["execution_boundary.py"],
    imports = ["."],
    deps = [
        "//src/pmc_core:pmc_core",
        "//tools/winstage:winstage",
    ],
)

# Slice 3: the execution boundary's own sabotage and positive-path probes.
# This target's own test process never loads the fixture PDB or launches
# PyMOL itself for most of its probes (the boundary under test does that,
# in its own spawned child); "conftest.py" is still needed as data because
# the positive-path test requests snapshot_support.py's module-scoped
# `real_pymol` fixture (re-exported by conftest.py) to compute an
# independent expected value.
#
# This is the one target in this directory that spawns a subprocess
# running real headless PyMOL, now that the H-02 snapshot candidates
# themselves have shipped as src/pmc_core/snapshot.py; slice 2's own
# outer-loop review (H02-S2-F9) is what originally justified factoring
# this shape into a shared build_defs.bzl macro across what were then five
# near-identical py_test blocks, and that macro is gone along with the
# other four.
py_test(
    name = "execution_boundary_probes",
    size = "large",
    timeout = "moderate",
    srcs = ["test_execution_boundary.py"],
    main = "test_execution_boundary.py",
    data = [
        "conftest.py",
    ],
    # Spawns a subprocess that launches its own real PyMOL process;
    # excluded from concurrent scheduling for the same reason as
    # tests/data:oracle_sabotage and tests/contract:policy_sabotage, so it
    # never races another subprocess-spawning test under Windows's
    # unsandboxed local execution strategy (observed CI flake).
    tags = ["exclusive"],
    # No longer excluded on Windows: pymol-open-source-whl's Windows wheel
    # bundles delvewheel-repaired DLLs whose long hash-suffixed names,
    # combined with Bazel's generated repository name, used to exceed
    # Windows' MAX_PATH. //tools/winstage:winstage now stages a
    # short-path copy before every real-PyMOL import in this directory
    # (a no-op on every other platform). See issue #12.
    deps = [
        ":execution_boundary",
        "//src/pmc_core:pmc_core",
        "//tests/integration:snapshot_support",
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
    ],
)
