load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")

# Slice 2's shared, candidate-agnostic differential harness (extraction
# format, extract()/_diff(), the fixture, and the nested-subprocess-via-
# environment-variable pattern), plus this directory's conftest.py, which
# re-exports harness.py's real_pymol/loaded_fixture fixtures once so every
# candidate test module below can request them by parameter name without
# importing them itself (see conftest.py's own docstring for why: ruff's
# F811, confirmed empirically). All three candidate test targets below
# depend on this library.
py_library(
    name = "harness",
    srcs = ["harness.py"],
    data = [
        "conftest.py",
        "testdata/h02_full_v1_fixture.pdb",
    ],
    imports = ["."],
    deps = [
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
    ],
)

py_test(
    # Named "harness_test" rather than "harness" (which this same file
    # already uses for the py_library target above) to avoid a same-package
    # Bazel target-name collision.
    name = "harness_test",
    size = "large",
    timeout = "moderate",
    srcs = ["test_harness.py"],
    main = "test_harness.py",
    # Spawns a nested pytest subprocess that launches its own real PyMOL
    # process and lets it reach shutdown before failing -- the masking
    # condition run_nested_snapshot_process works around only manifests
    # once real PyMOL is actually involved, so this target can no longer be
    # the PyMOL-free "small" target it started as. Excluded from
    # concurrent scheduling for the same reason as tests/data:oracle_sabotage
    # and tests/contract:policy_sabotage, so it never races another
    # subprocess-spawning test under Windows's unsandboxed local execution
    # strategy (observed CI flake).
    tags = ["exclusive"],
    # See tests/integration/BUILD.bazel's real_pymol_command target and
    # issue #12: pymol-open-source-whl's Windows wheel bundles
    # delvewheel-repaired DLLs whose long hash-suffixed names, combined
    # with Bazel's generated repository name, exceed Windows' MAX_PATH.
    # Deliberate trade: this target gives up the "runs on Windows" property
    # the old PyMOL-free version had, in exchange for actually being able
    # to detect the regression it exists to guard against.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        ":harness",
        "@pypi//pymol_open_source_whl",
        "@pypi//pytest",
    ],
)

