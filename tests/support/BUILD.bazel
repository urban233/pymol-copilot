load("@rules_python//python:py_library.bzl", "py_library")

# The first shared test-support library under tests/ (H-02's own harness.py
# stayed local to tests/discovery/h02 because nothing else needed it yet;
# see winstage.py's own docstring for why Windows now does). Every test
# process that imports real PyMOL on Windows calls
# `winstage.ensure_importable()` immediately before doing so; it is a no-op
# everywhere else. See issue #12.
py_library(
    name = "winstage",
    srcs = ["winstage.py"],
    imports = ["."],
    visibility = [
        "//tests/discovery/h02:__pkg__",
        "//tests/integration:__pkg__",
    ],
    deps = ["@pypi//pymol_open_source_whl"],
)
